# Apache config for the static build. Copied into dist/ by `npm run build`, so it ships
# with every upload. It does on Apache what vercel.json does on Vercel: clean URLs
# (/clothing/school-uniform serves clothing/school-uniform.html), one canonical host,
# old-URL redirects, the site's own 404 page, compression and cache headers.
# Needs mod_rewrite, mod_headers, mod_deflate and `AllowOverride All` for the web root.

Options -Indexes -MultiViews
# /clothing is both a page (clothing.html) and a folder (clothing/). Without this Apache
# redirects /clothing to /clothing/ and answers 403.
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One host, HTTPS only: www and http go to https://dctshirtfactory.co.in
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Old URLs (same as vercel.json)
  RewriteRule ^products/([^/]+)/?$ /clothing/$1 [R=301,L]
  RewriteRule ^quote/?$ /contact [R=301,L]
  RewriteRule ^clients/?$ /work [R=301,L]

  # /index.html -> /   and   /page.html -> /page  (only for addresses typed or linked
  # with .html; the internal rewrite below never loops back here)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /page/ -> /page
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve /page from page.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <If "%{REQUEST_URI} =~ m#^/(img|vendor)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(css|js)/#">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </If>
</IfModule>
